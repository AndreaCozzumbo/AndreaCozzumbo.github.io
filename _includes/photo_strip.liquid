{%- comment -%}
  Horizontal gallery of all the photos of _data/photos.yml, in random order at each
  visit. The arrows go round and round: copies of the photos stand before and after
  them, and the position jumps back to the real ones when the movement ends.
{%- endcomment -%}
<section class="photo-strip" aria-label="Gallery, in random order">
<div class="photo-strip-track pswp-gallery">
{%- for series in site.data.photos -%}
{%- for p in series.photos -%}
{%- capture alt -%}{%- if p.alt and p.alt != '' -%}{{ p.alt }}{%- else -%}Photograph{%- endif -%}{%- endcapture -%}
<a href="{{ '/assets/photos/' | append: p.file | append: '?v=' | append: p.id | relative_url }}" data-pswp-width="{{ p.width }}" data-pswp-height="{{ p.height }}" style="--ratio: {{ p.width | times: 1.0 | divided_by: p.height | round: 4 }}" target="_blank" rel="noopener"><img loading="lazy" src="{{ '/assets/photos/thumbs/' | append: p.file | append: '?v=' | append: p.id | relative_url }}" width="{{ p.width }}" height="{{ p.height }}" alt="{{ alt | escape }}" decoding="async" draggable="false"></a>
{%- endfor -%}
{%- endfor -%}
</div>
<button class="photo-strip-arrow photo-strip-prev" type="button" aria-label="Previous photo"><i class="fa-solid fa-arrow-left"></i></button>
<button class="photo-strip-arrow photo-strip-next" type="button" aria-label="Next photo"><i class="fa-solid fa-arrow-right"></i></button>
</section>
<script>
(() => {
  const strip = document.querySelector('.photo-strip');
  const track = strip.querySelector('.photo-strip-track');
  const photos = [...track.children];

  // random order (Fisher-Yates)
  for (let i = photos.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [photos[i], photos[j]] = [photos[j], photos[i]];
  }
  const copies = () => photos.map((photo) => {
    const copy = document.createElement('div');
    copy.setAttribute('aria-hidden', 'true');
    copy.style.cssText = photo.style.cssText;
    copy.append(photo.firstElementChild.cloneNode());
    copy.addEventListener('click', () => { settle(); photo.click(); });
    return copy;
  });
  track.replaceChildren(...copies(), ...photos, ...copies());

  const all = [...track.children];
  const n = photos.length;
  const centre = (el) => el.offsetLeft + el.offsetWidth / 2 - track.clientWidth / 2;
  const loop = () => all[n].offsetLeft - all[0].offsetLeft; // length of one set
  const current = () => {
    let best = 0;
    all.forEach((el, i) => {
      if (Math.abs(centre(el) - track.scrollLeft) < Math.abs(centre(all[best]) - track.scrollLeft)) best = i;
    });
    return best;
  };
  const jump = (x) => track.scrollTo({ left: x, behavior: 'instant' });

  // from a copy to the same photo in the middle set
  function settle() {
    const i = current();
    if (i < n) jump(track.scrollLeft + loop());
    else if (i >= 2 * n) jump(track.scrollLeft - loop());
  }

  const smooth = matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth';
  let target = n;
  let timer;
  const move = (step) => {
    clearTimeout(timer);
    if (target + step < 1 || target + step > all.length - 2) {
      target += target < n ? n : -n;
      jump(centre(all[target]));
    }
    target += step;
    track.scrollTo({ left: centre(all[target]), behavior: smooth });
  };
  strip.querySelector('.photo-strip-prev').addEventListener('click', () => move(-1));
  strip.querySelector('.photo-strip-next').addEventListener('click', () => move(1));

  track.addEventListener('scroll', () => {
    clearTimeout(timer);
    timer = setTimeout(() => { settle(); target = current(); }, 160);
  }, { passive: true });

  const start = () => jump(centre(all[target]));
  start();
  addEventListener('resize', start);
})();
</script>
